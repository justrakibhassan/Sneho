# ==============================================
# SERVER CONFIGURATION
# ==============================================
PORT=5000
NODE_ENV=development

# ==============================================
# DATABASE CONFIGURATION
# ==============================================
# Local MySQL (Development)
DATABASE_URL="mysql://root:password@localhost:3306/new-care"

# Production MySQL (Railway/PlanetScale)
# DATABASE_URL="mysql://user:password@host:port/database?sslaccept=strict"

# ==============================================
# AUTHENTICATION & SECURITY
# ==============================================
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:3000

# ==============================================
# CLOUDINARY (Image Upload)
# ==============================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ==============================================
# STREAM CHAT
# ==============================================
STREAM_API_KEY=your_stream_api_key
STREAM_SECRET_KEY=your_stream_secret_key

# ==============================================
# PAYMENT (Stripe)
# ==============================================
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key

# ==============================================
# EMAIL (Optional - for notifications)
# ==============================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password

# ==============================================
# PRODUCTION DEPLOYMENT NOTES
# ==============================================
# For Render deployment:
# 1. Set NODE_ENV=production
# 2. Update DATABASE_URL with production database
# 3. Update CLIENT_URL with Vercel frontend URL
# 4. Generate strong JWT_SECRET (min 32 characters)
# 5. Add all Cloudinary, Stream, and Stripe keys
# ==============================================
